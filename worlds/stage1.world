<?xml version="1.0"?>
<sdf version="1.6">
  <world name="stage1">

    <!-- Camera straight above the scene, looking down: a 2D top view -->
    <gui>
      <camera name="user_camera">
        <pose>3 0 9 0 1.5707 0</pose>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Stage 1 obstacle: the same rectangle as rectangle(3, 0, 1, 1) in obstacles.py -->
    <model name="obstacle">
      <static>true</static>
      <pose>3 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1 0.5</size></box></geometry>
          <material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- The car: 0.45 x 0.25 m, moves only in the plane -->
    <model name="car">
      <pose>0 0 0.1 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.01</ixx><iyy>0.02</iyy><izz>0.03</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c"><pose>0.15 0 0 0 0 0</pose><geometry><box><size>0.45 0.25 0.2</size></box></geometry></collision>
        <visual name="v"><pose>0.15 0 0 0 0 0</pose><geometry><box><size>0.45 0.25 0.2</size></box></geometry>
          <material><ambient>0.2 0.4 0.9 1</ambient><diffuse>0.2 0.4 0.9 1</diffuse></material></visual>
      </link>

      <!-- In: /car/cmd_vel (v, omega)   Out: /car/odom (x, y, heading of P) -->
      <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
        <ros><namespace>/car</namespace></ros>
        <update_rate>50</update_rate>
        <publish_rate>20</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_link</robot_base_frame>
      </plugin>
    </model>

  </world>
</sdf>
